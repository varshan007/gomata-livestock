# Database Connections
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/livestock_monitoring
REDIS_URL=rediss://default:<password>@<upstash-endpoint>:<port>

# URLs
FRONTEND_URL=https://gomata-frontend.vercel.app
ML_SERVICE_URL=https://gomata-ml.onrender.com

# Authentication
JWT_SECRET=your_secure_random_jwt_secret
REFRESH_TOKEN_SECRET=your_secure_random_refresh_secret

# Optional: Twilio for SMS/WhatsApp Alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional: Gemini API for AI Chat
GEMINI_API_KEY=

# Thresholds & Simulation
SIMULATION_TICK_MS=60000
ALERT_TEMP_THRESHOLD=39.5
ALERT_BATTERY_THRESHOLD=15
